# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://allstocks:allstocks@localhost:5432/allstocks
REDIS_URL=redis://localhost:6379

# openssl rand -base64 32
ALLSTOCKS_KEK=
ALLSTOCKS_MULTI_USER=false

# Discovered in M1 (docs/01-STOCKBIT-ADAPTER.md §2), not hardcoded in source.
STOCKBIT_BASE_URL=
STOCKBIT_RATE_LIMIT_RPS=2
STOCKBIT_MAX_CONCURRENCY=1
STOCKBIT_DAILY_REQUEST_BUDGET=5000
STOCKBIT_LOGIN_MODE=browser

INGEST_TZ=Asia/Jakarta
INGEST_CRON_ENABLED=true
SCREENERS_ENABLED=graham-defensive,magic-formula,canslim-idx,trending-value
LOG_LEVEL=info
